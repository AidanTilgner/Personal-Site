---
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience";
---

<Layout title="Home">
  <main>
    <section class="experience">
      <Experience client:load />
    </section>
  </main>
</Layout>

<style lang="scss">
  main {
    height: calc(100dvh - var(--home-nav-height));
    min-height: 0;
    overflow: hidden;
  }

  .experience {
    width: 100%;
    height: 100%;
  }

  :global(body) {
    overflow: hidden;
  }
</style>
