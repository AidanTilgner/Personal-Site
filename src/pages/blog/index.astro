---
import Layout from "../../layouts/Layout.astro";
import Posts from "../../components/Blog/Posts/Posts";
import { getCollection } from "astro:content";

const mappedPosts = (await getCollection("blog")).map((post) => {
  const { title, author, description, postdate, updatedate, tags, draft } =
    post.data;
  return {
    title,
    author,
    description,
    postdate,
    updatedate,
    tags,
    url: `/blog/posts/${post.id}`,
    draft,
  };
});
const publishedCount = mappedPosts.filter((post) => !post.draft).length;
---

<Layout title="Blog">
  <main>
    <header class="page-intro">
      <p class="eyebrow">
        Writing / {publishedCount.toString().padStart(2, "0")}
      </p>
      <h1>My writing.</h1>
      <p class="lede">
        Essays, field notes, and unfinished musings about software, language,
        systems, and the web.
      </p>
    </header>
    <section class="posts">
      <Posts posts={mappedPosts} client:load />
    </section>
  </main>
</Layout>

<style lang="scss">
  main {
    width: min(100%, 144rem);
    min-height: calc(100vh - var(--home-nav-height));
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 10rem) clamp(2.4rem, 6vw, 8rem) 8rem;
  }

  .page-intro {
    max-width: 92rem;
    margin-bottom: clamp(5rem, 8vw, 9rem);
  }

  .eyebrow {
    margin: 0 0 2.4rem;
    color: rgb(var(--accent-color));
    font-family: var(--code-font-family);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.8rem, 6vw, 5.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .lede {
    max-width: 68rem;
    margin: 3rem 0 0;
    color: rgb(var(--muted-color));
    font-size: clamp(1.5rem, 1.6vw, 1.6rem);
    line-height: 1.55;
  }

  .posts {
    border-top: 1px solid rgba(var(--text-color), 0.14);
    padding-top: 2.4rem;
  }
</style>
