---
import Navbar from "../components/Navigation/Navbar/Navbar";
import FloatingAssistant from "../components/Assistant/FloatingAssistant";
export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const assistantRoutes = ["/projects", "/blog", "/stuff"];
const showFloatingAssistant = assistantRoutes.some((route) =>
  Astro.url.pathname.startsWith(route),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={description || "Aidan's corner of the interweb."}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Aidan's Site</title>
  </head>
  <body>
    <Navbar client:load />
    <slot />
    {
      showFloatingAssistant && (
        <FloatingAssistant pagePath={Astro.url.pathname} client:load />
      )
    }
    <style lang="scss" is:global>
      html {
        --background-color: 9, 11, 12;
        --surface-color: 13, 16, 18;
        --surface-raised: 17, 20, 23;
        --heading-color: 243, 244, 246;
        --text-color: 209, 213, 219;
        --muted-color: 156, 163, 175;
        --accent-color: 147, 51, 234;
        --accent-ink: 243, 244, 246;
        --camel-color: 231, 176, 111;
        --warning-color: 231, 176, 111;
        --heading-font-family: "JetBrains Mono", monospace;
        --font-family: "IBM Plex Mono", monospace;
        --code-font-family: "IBM Plex Mono", monospace;
        --home-nav-height: 5.9rem;
        color-scheme: dark;
        font-size: 10px;
        background: rgb(var(--background-color));
      }

      html[data-nav-scrolled="true"] {
        --home-nav-height: 3.9rem;
      }

      @media (max-width: 759px) {
        html {
          --home-nav-height: 7.7rem;
        }

        html[data-nav-scrolled="true"] {
          --home-nav-height: 6.5rem;
        }
      }

      body {
        min-width: 32rem;
        min-height: 100vh;
        background-color: rgb(var(--background-color));
        background-image:
          linear-gradient(
            rgba(var(--heading-color), 0.018) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(var(--heading-color), 0.018) 1px,
            transparent 1px
          );
        background-size: 4.8rem 4.8rem;
        color: rgb(var(--text-color));
        font-family: var(--font-family);
        font-size: 1.6rem;
        letter-spacing: 0.005em;
        line-height: 1.6;
        margin: 0;
        padding: 0;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      * {
        box-sizing: border-box;
      }

      h1,
      h2,
      h3 {
        color: rgb(var(--heading-color));
        font-family: var(--heading-font-family);
        font-weight: 600;
        letter-spacing: -0.035em;
        text-transform: none;
      }

      p {
        max-width: 65ch;
      }

      a {
        color: rgb(var(--accent-color));
        text-decoration: none;

        &:hover {
          text-decoration: underline;
        }
      }

      button,
      input,
      select,
      textarea {
        border-radius: 0;
        font: inherit;
      }

      :focus-visible {
        outline: 2px solid rgb(var(--accent-color));
        outline-offset: 3px;
      }

      ::selection {
        background: rgb(var(--accent-color));
        color: rgb(var(--accent-ink));
      }

      .wip {
        color: rgb(var(--warning-color));
      }

      .back-button {
        font-size: 1.8rem;
        color: rgba($color: var(--text-color), $alpha: 0.6);
        display: flex;
        align-items: center;
        gap: 0.8rem;

        @media (min-width: 768px) {
          font-size: 1.6rem;
        }

        &:hover {
          svg {
            transform: translateX(-0.4rem);
          }
        }
      }

      .select {
        box-sizing: border-box;
        border: 1px solid rgb(var(--text-color));
        background-color: rgb(var(--background-color));
        color: rgb(var(--text-color));
        padding: 1.4rem 1.8rem;
      }
    </style>
  </body>
</html>
