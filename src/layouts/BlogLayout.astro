---
import Layout from "./Layout.astro";
import type { BlogPost } from "../types/main.d";
import { getPrettyDate } from "../utils/formatting";

type Props = { frontmatter: BlogPost };

const {
  frontmatter: {
    title,
    author,
    description,
    postdate,
    tags,
    draft,
    sourceLabel,
    canonicalUrl,
  },
} = Astro.props;
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <main class="article-shell">
    <a class="article-back" href="/blog"
      ><span aria-hidden="true">←</span> Writing</a
    >

    <header class="article-header">
      {draft && <p class="article-draft">Draft / work in progress</p>}
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      <div class="article-meta">
        <span>{author}</span>
        <span>{getPrettyDate(postdate)}</span>
        {sourceLabel && <span>{sourceLabel}</span>}
        <div class="article-tags">
          {
            tags.map((tag) => (
              <a href={`/blog?filter=${encodeURIComponent(tag)}`}>{tag}</a>
            ))
          }
        </div>
      </div>
      {
        canonicalUrl && (
          <a
            class="article-source-action"
            href={canonicalUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Read the original on Substack <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </header>

    <article class="article-body">
      <slot />
    </article>
    {
      canonicalUrl && (
        <footer class="article-source">
          <span>Originally published in {sourceLabel}</span>
          <a href={canonicalUrl} target="_blank" rel="noopener noreferrer">
            View on Substack <span aria-hidden="true">↗</span>
          </a>
        </footer>
      )
    }
  </main>
</Layout>

<style lang="scss" is:global>
  .article-shell {
    width: min(100%, 124rem);
    margin: 0 auto;
    padding: 4rem clamp(2.4rem, 7vw, 9rem) 10rem;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: rgb(var(--muted-color));
    font-family: var(--code-font-family);
    font-size: 1.1rem;

    &:hover {
      color: rgb(var(--accent-color));
      text-decoration: none;
    }
  }

  .article-header {
    max-width: 98rem;
    margin: clamp(5rem, 9vw, 11rem) 0 clamp(5rem, 9vw, 10rem);
  }

  .article-draft {
    margin: 0 0 2rem;
    color: rgb(var(--warning-color));
    font-family: var(--code-font-family);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .article-header h1 {
    max-width: 105rem;
    margin: 0;
    font-size: clamp(3.8rem, 6vw, 5.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }

  .article-description {
    max-width: 72rem;
    margin: 3rem 0 0;
    color: rgba(var(--text-color), 0.5);
    font-size: clamp(1.5rem, 1.6vw, 1.6rem);
    line-height: 1.55;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
    margin-top: 3.2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--text-color), 0.12);
    color: rgba(var(--text-color), 0.36);
    font-family: var(--code-font-family);
    font-size: 1rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;

    a {
      padding: 0.45rem 0.75rem;
      border: 1px solid rgba(var(--text-color), 0.12);
      border-radius: 0;
      color: rgba(var(--text-color), 0.45);

      &:hover {
        border-color: rgba(var(--accent-color), 0.5);
        color: rgb(var(--accent-color));
        text-decoration: none;
      }
    }
  }

  .article-source-action {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.4rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid rgba(var(--accent-color), 0.72);
    color: rgb(var(--accent-color));
    font-family: var(--code-font-family);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;

    &:hover {
      background: rgb(var(--accent-color));
      color: rgb(var(--accent-ink));
      text-decoration: none;
    }
  }

  .article-body {
    max-width: 65ch;
    color: rgba(var(--text-color), 0.76);
    font-size: clamp(1.5rem, 1.6vw, 1.6rem);
    line-height: 1.78;

    h2,
    h3 {
      color: rgb(var(--text-color));
      font-weight: 560;
      letter-spacing: -0.035em;
      line-height: 1.15;
    }

    h2 {
      margin: 6rem 0 2rem;
      font-size: clamp(2.4rem, 3vw, 2.8rem);
    }

    h3 {
      margin: 4.5rem 0 1.6rem;
      font-size: clamp(2rem, 2.5vw, 2.4rem);
    }

    p,
    ul,
    ol,
    pre,
    blockquote {
      margin: 0 0 2.4rem;
    }

    a {
      text-decoration: underline;
      text-decoration-color: rgba(var(--accent-color), 0.45);
      text-underline-offset: 0.18em;
    }

    blockquote {
      padding-left: 2rem;
      border-left: 2px solid rgb(var(--accent-color));
      color: rgb(var(--muted-color));
    }

    code,
    pre {
      font-family: var(--code-font-family);
    }

    pre {
      overflow-x: auto;
      padding: 2rem;
      border: 1px solid rgba(var(--text-color), 0.12);
      background: rgb(var(--surface-color));
      font-size: 1.35rem;
      line-height: 1.6;
    }

    img,
    video {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
    }

    picture,
    figure > a {
      display: block;
    }

    figure {
      margin: 3.2rem 0;
    }

    figcaption {
      margin-top: 0.8rem;
      color: rgba(var(--text-color), 0.42);
      font-family: var(--code-font-family);
      font-size: 1.1rem;
      line-height: 1.5;
    }

    iframe {
      width: 100%;
      max-width: 100%;
      border: 1px solid rgba(var(--text-color), 0.12);
      aspect-ratio: 16 / 9;
    }

    audio {
      width: 100%;
      margin: 0 0 3.2rem;
    }

    hr {
      margin: 4.8rem 0;
      border: 0;
      border-top: 1px solid rgba(var(--text-color), 0.12);
    }
  }

  .article-source {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    max-width: 65ch;
    margin-top: 7rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--text-color), 0.12);
    color: rgba(var(--text-color), 0.42);
    font-family: var(--code-font-family);
    font-size: 1.05rem;

    a:hover {
      text-decoration: none;
    }
  }

  @media (max-width: 680px) {
    .article-shell {
      padding-top: 2.8rem;
    }

    .article-meta {
      align-items: flex-start;
      flex-direction: column;
    }

    .article-source {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
