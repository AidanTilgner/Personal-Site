{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:astro": "ASTRO_DEV_BACKGROUND=0 astro dev --force --port ${ASTRO_PORT:-4321}",
    "build:astro": "astro build",
    "preview:astro": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "dev:server": "bun --watch ./app/index.ts",
    "start:server": "bun ./app/index.ts",
    "start:astro": "PORT=${ASTRO_PORT:-3004} bun ./dist/server/entry.mjs",
    "format": "prettier --write .",
    "start": "concurrently --kill-others-on-fail \"bun run start:astro\" \"bun run start:server\"",
    "dev": "concurrently --kill-others-on-fail \"bun run dev:astro\" \"bun run dev:server\""
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/node": "^11.0.3",
    "@astrojs/react": "^6.0.2",
    "@elysia/cors": "^1.4.2",
    "@phosphor-icons/react": "^2.0.10",
    "astro": "^7.1.6",
    "dompurify": "^3.4.13",
    "elysia": "^1.4.29",
    "fast-xml-parser": "^5.10.1",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.6",
    "sass": "^1.64.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.0.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
