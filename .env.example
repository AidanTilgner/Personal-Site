ASTRO_PORT=4321
SERVER_PORT=8080
PUBLIC_BACKEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
CHAT_REQUESTS_PER_MINUTE=10
CHAT_MAX_CONCURRENT=4
